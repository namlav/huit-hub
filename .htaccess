# The application lives in public/. If the virtual host points at the project
# root, forward every request there; deny access to source and dotfiles.
Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule ^(vendor|config|database|agent)/ - [F,L]

RewriteCond %{REQUEST_URI} !/public/
RewriteRule ^(.*)$ public/$1 [L]
